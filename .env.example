# 服务监听端口与主机
PORT=3000
HOST=0.0.0.0

# 对外暴露给第三方框架（NextChat / Cursor / OneAPI）的统一 API Key
API_MASTER_KEY=sk-antigravity

# 访问 Web 管理控制台 (/admin) 的管理密码
ADMIN_PASSWORD=admin123

# Google CloudCode 上游接口地址
UPSTREAM_URL=https://daily-cloudcode-pa.googleapis.com/v1internal:streamGenerateContent?alt=sse

# 自定义 Google OAuth 凭证（可选，默认使用内置官方兼容凭证）
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
