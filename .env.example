# 服务监听端口与主机
PORT=3000
HOST=0.0.0.0

# 对外暴露给第三方框架（NextChat / Cursor / OneAPI）的统一 API Key
API_MASTER_KEY=sk-antigravity

# 访问 Web 管理控制台 (/admin) 的管理密码
ADMIN_PASSWORD=admin123

# Google CloudCode 上游接口地址
UPSTREAM_URL=https://daily-cloudcode-pa.googleapis.com/v1internal:streamGenerateContent?alt=sse

# 自定义 Google OAuth 凭证（可选，默认使用内置官方兼容凭证）
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# 全局兜底代理出口（留空的账号走这里；多账号建议改为每账号单独配置 proxyUrl）
# DEFAULT_PROXY_URL=http://127.0.0.1:7897

# 单次生成等待响应头 / 等待下一块的上限（毫秒，默认 15 分钟）
# UPSTREAM_TIMEOUT_MS=900000

# 长思考 SSE 保活间隔（毫秒，默认 15000）
# STREAM_KEEPALIVE_MS=15000

# 调度策略：zero-waste / sequential-drain / round-robin
# ROUTING_STRATEGY=zero-waste

# 同账号两次生成启动的最小间隔（毫秒，默认 1000；0 关闭）
# MIN_REQUEST_INTERVAL_MS=1000

# Token 续期轮询周期（毫秒，默认 180000）
# TOKEN_REFRESH_INTERVAL_MS=180000
